#!/usr/bin/env bash

{{ if eq .osid "linux-fedora" -}}

set -euo pipefail

# Update cache and already installed programs
sudo dnf upgrade -y

# Install programs with dnf
sudo dnf install -y \
    {{ .packages.universal.package_managers | join " " }} \
    {{ .packages.fedora.dnf | join " " }}

# Install programs with custom install scripts
{{ range .packages.universal.wild_west -}}
if ! command -v {{ .name }} >/dev/null 2>&1; then
    {{ .command }}
else
    echo {{ .name }} already installed
fi
{{ end }}

# Install programs with flatpak
{{ range .packages.universal.flatpak -}}
{{ range $repo, $packages := . -}}
flatpak install -y {{ $repo }} {{ $packages | join " " -}}
{{ end -}}
{{ end }}

# Install programs with pip
python3 -m pip install -U {{ .packages.universal.pip | join " " }}

# Install programs from git
mkdir -p ~/programs
cd ~/programs
{{ range .packages.universal.git -}}
git clone {{ .url }} || git -C {{ .url | splitList "/" | last | splitList ".git" | first }} pull
cd {{ .url | splitList "/" | last | splitList ".git" | first }}
{{ .install_command }}
{{ end }}

# Set up favourite apps
gsettings set org.gnome.shell favorite-apps "['app.zen_browser.zen.desktop', 'dev.zed.Zed.desktop', 'org.gnome.Nautilus.desktop']"

{{ end }}
