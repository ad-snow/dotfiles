// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Theme
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light Hard",
    "dark": "Gruvbox Dark Hard",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },

  // Formatting
  "format_on_save": "off",
  "preferred_line_length": 120,
  "show_wrap_guides": true,
  "wrap_guides": [80, 100, 120],
  "show_whitespaces": "boundary",
  "remove_trailing_whitespace_on_save": true,
  "languages": {
    "Markdown": {
      "remove_trailing_whitespace_on_save": false
    }
  },

  // UI
  "minimap": {
    "thumb_border": "left_open",
    "show": "auto",
  },
  "scrollbar": {
    "show": "auto",
  },

  // UX
  "sticky_scroll": {
    "enabled": true,
  },
  "helix_mode": false,
  "vim_mode": false,

  "cli_default_open_behavior": "new_window",

  // Telemetry
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
  },

  // Fonts
  "buffer_font_family": "Monaspace Xenon Var",
  "buffer_font_size": 15,
  "buffer_font_features": {
    "calt": true,
    "ss01": true,
    "ss02": true,
    "sso3": true,
    "ss06": true,
    "ss09": true,
    "liga": true,
  },
  "ui_font_family": "Monaspace Radon Var",
  "ui_font_size": 16,
  "terminal": {
    "font_family": "Monaspace Argon Var",
  },

  // AI
  {{ if ne .work true -}}
  "disable_ai": true
  {{- else -}}
  "disable_ai": false,
  "context_servers": {
    "unreal-editor": {
      "enabled": true,
      "url": "http://127.0.0.1:8000/mcp"
    },
    "xjedsy-automated-testing": {
      "enabled": true,
      "url": "http://127.0.0.1:8421/mcp",
      "timeout": 600
    }
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "agent": {
    "profiles": {
      "ask": {
        "name": "Ask",
        "tools": {
          "create_thread": true,
          "diagnostics": true,
          "fetch": true,
          "list_agents_and_models": true,
          "list_directory": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "read_file": true,
          "grep": true,
          "skill": true,
          "spawn_agent": true,
          "search_web": true
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "xjedsy-automated-testing": {
            "tools": {
              "xjat_list_runs": true,
              "xjat_list_blocks": true,
              "xjat_get_text_log": true,
              "xjat_get_run": true,
              "xjat_list_tests": true,
              "xjat_run_test": true,
              "xjat_list_steps": true,
              "xjat_list_px4_logs": true,
              "xjat_list_log_checks": true,
              "xjat_list_console_logs": true,
              "xjat_list_checks": true,
              "xjat_get_px4_log_messages": true,
              "xjat_get_px4_log_info": true,
              "xjat_get_px4_log": true,
              "xjat_get_console_log": true,
              "run_test": false,
              "list_tests": true,
              "list_test_steps": true,
              "list_test_log_checks": true,
              "list_test_checks": true
            }
          }
        }
      }
    },
    "sandbox_permissions": {
      "network_hosts": [
        "raw.githubusercontent.com",
        "api.github.com",
        "github.com",
        "git.kernel.org",
        "cdn.jsdelivr.net",
        "elixir.bootlin.com",
        "zed.dev",
        "code.visualstudio.com",
        "docs.docker.com",
        "specifications.freedesktop.org",
        "gitlab.gnome.org"
      ],
      "allow_unsandboxed": false
    },
    "tool_permissions": {
      "tools": {
        "mcp:xjedsy-automated-testing:xjat_list_blocks": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_list_steps": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_list_log_checks": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_list_checks": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_get_run": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_list_runs": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_get_text_log": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_get_px4_log_info": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_get_px4_log_messages": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_run_test": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_get_px4_log": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_get_console_log": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_list_px4_logs": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_list_console_logs": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_list_test_log_checks": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_list_test_checks": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_list_test_steps": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:xjat_list_tests": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:run_test": {
          "default": "allow"
        },
        "mcp:xjedsy-automated-testing:list_tests": {
          "default": "allow"
        },
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com"
            },
            {
              "pattern": "^https?://api\\.github\\.com"
            },
            {
              "pattern": "^https?://zed\\.dev"
            }
          ]
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^sed\\s+s/\\[0-9\\]\\[0-9\\.e\\+-\\]\\*//g(\\s|$)"
            },
            {
              "pattern": "^sort\\b"
            },
            {
              "pattern": "^uniq\\b"
            },
            {
              "pattern": "^ls\\b"
            },
            {
              "pattern": "^echo\\s+===(\\s|$)"
            },
            {
              "pattern": "^echo\\b"
            }
          ]
        }
      }
    },
    "single_file_review": true,
    "default_profile": "write",
    "default_model": {
      "effort": "max",
      "provider": "copilot_chat",
      "model": "gpt-6-astra",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  }
  {{- end }}
}
